[Unit]
Description=Project Monitoring System queue worker
After=network.target postgresql.service

[Service]
Type=simple
User=pms
Group=pms
WorkingDirectory=/opt/pms/current
ExecStart=/usr/bin/php artisan queue:work --sleep=3 --tries=3 --max-time=3600 --no-interaction
ExecReload=/usr/bin/php artisan queue:restart
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
