* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Installed verbatim on the production host and executed by root or systemd.
# Any normalisation would make the versioned copy differ from what actually runs.
deploy/sbin/* -text
deploy/systemd/* -text
